# ============================================================================
# ARCH-DEPLOY-001 — Plantilla de Variables de Entorno (.env.example)
# Copiar a .env y reemplazar todos los valores marcados con CHANGE_ME
# NUNCA subir el archivo .env con secretos reales a Git
# ============================================================================

# --- Modo de Despliegue (raspberry | vps) ---
DEPLOY_TARGET=raspberry
ENVIRONMENT=lab
TLS_DOMAIN=idolo-raspberry.local

# --- Red y Puertos Expuestos por Nginx (en Raspberry Pi usa 8080/8443; en VPS usa 80/443) ---
BIND_IP=0.0.0.0
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Modo del Cliente Frontend (local | server) ---
VITE_AUTH_MODE=server

# --- Base de Datos PostgreSQL (Red interna privada backend_net) ---
POSTGRES_USER=idolo_user
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_24
POSTGRES_DB=idolo_db

# --- Criptografía Backend (HMAC-SHA256 y Sesiones Opacas) ---
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ADMIN_AUDIT_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_24
COOKIE_SECURE=true
CSRF_PROTECTION_ENABLED=true
SESSION_TTL_SECONDS=28800

# --- Parámetros Argon2id (Calibrables según RAM disponible en Raspberry Pi o VPS) ---
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# --- Límites de Tasa (Rate Limiting por minuto) ---
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
UVICORN_WORKERS=1
